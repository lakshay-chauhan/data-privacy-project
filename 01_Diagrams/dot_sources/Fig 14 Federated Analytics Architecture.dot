}
subgraph cluster_3 { label="Model registry and monitor"; labeljust=l; fontsize=8.5; style="rounded,filled"; fillcolor="#F2EAF8"; color="#8E5BB5"; penwidth=0.9; margin=7;
{rank=same; l3i0 [label="Global model", fillcolor="white", color="#8E5BB5"]; l3i1 [label="Trust monitor", fillcolor="white", color="#8E5BB5"]; }
l3i0 -> l3i1 [style=invis];
}
