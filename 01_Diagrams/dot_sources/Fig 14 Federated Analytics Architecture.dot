digraph G { graph [fontname="Liberation Sans", fontsize=9, bgcolor="white", pad=0.04, nodesep=0.14, ranksep=0.2, compound=true, size="3.45,8.2", splines=true]; node [shape=box, style="rounded,filled", fontname="Liberation Sans", fontsize=8.5, fillcolor="#EAF1FB", color="#2F6DB5", penwidth=0.8, margin="0.07,0.035"]; edge [color="#4B5563", arrowsize=0.6, penwidth=0.8, fontname="Liberation Sans", fontsize=7.5]; rankdir=TB;
subgraph cluster_0 { label="Edge clients"; labeljust=l; fontsize=8.5; style="rounded,filled"; fillcolor="#EAF1FB"; color="#2F6DB5"; penwidth=0.9; margin=7;
{rank=same; l0i0 [label="Local data", fillcolor="white", color="#2F6DB5"]; l0i1 [label="Local training", fillcolor="white", color="#2F6DB5"]; l0i2 [label="Clip + noise", fillcolor="white", color="#2F6DB5"]; }
l0i0 -> l0i1 [style=invis];
l0i1 -> l0i2 [style=invis];
}
