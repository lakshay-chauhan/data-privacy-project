{rank=same; l1i0 [label="Pairwise masks", fillcolor="white", color="#E07B39"]; l1i1 [label="Masked updates", fillcolor="white", color="#E07B39"]; }
l1i0 -> l1i1 [style=invis];
}
subgraph cluster_2 { label="Aggregator"; labeljust=l; fontsize=8.5; style="rounded,filled"; fillcolor="#E9F6EF"; color="#3A9D6E"; penwidth=0.9; margin=7;
{rank=same; l2i0 [label="FedAvg / median", fillcolor="white", color="#3A9D6E"]; l2i1 [label="Privacy accountant", fillcolor="white", color="#3A9D6E"]; }
