digraph G { graph [fontname="Liberation Sans", fontsize=9, bgcolor="white", pad=0.04, nodesep=0.14, ranksep=0.2, compound=true, size="3.45,8.2", splines=true]; node [shape=box, style="rounded,filled", fontname="Liberation Sans", fontsize=8.5, fillcolor="#EAF1FB", color="#2F6DB5", penwidth=0.8, margin="0.07,0.035"]; edge [color="#4B5563", arrowsize=0.6, penwidth=0.8, fontname="Liberation Sans", fontsize=7.5]; rankdir=TB;
n0 [label="1  Server broadcasts the
global model to clients", fillcolor="#EAF1FB", color="#2F6DB5"];
n1 [label="2  Clients train on
private local data", fillcolor="#FDF0E6", color="#E07B39"];
n2 [label="3  Clip update and add
Gaussian noise (DP)", fillcolor="#E9F6EF", color="#3A9D6E"];
n3 [label="4  Mask update
(secure aggregation)", fillcolor="#F2EAF8", color="#8E5BB5"];
n4 [label="5  Server sums updates;
masks cancel; FedAvg", fillcolor="#F3F4F6", color="#6B7280"];
n5 [label="6  Evaluate, log and
start next round", fillcolor="#FFF8DB", color="#B8860B"];
n0 -> n1;
n1 -> n2;
n2 -> n3;
n3 -> n4;
n4 -> n5;
n5 -> n0 [style=dashed, constraint=false, label="next round", color="#E07B39", fontcolor="#E07B39"];
}