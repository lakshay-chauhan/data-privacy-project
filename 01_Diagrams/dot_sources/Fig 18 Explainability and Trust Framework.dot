subgraph cluster_4 { label="Human oversight"; labeljust=l; fontsize=8.5; style="rounded,filled"; fillcolor="#F3F4F6"; color="#6B7280"; penwidth=0.9; margin=7;
{rank=same; l4i0 [label="Review queue", fillcolor="white", color="#6B7280"]; l4i1 [label="Override", fillcolor="white", color="#6B7280"]; }
