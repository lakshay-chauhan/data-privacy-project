l1i0 -> l1i1 [style=invis];
}
subgraph cluster_2 { label="Trust assessment"; labeljust=l; fontsize=8.5; style="rounded,filled"; fillcolor="#E9F6EF"; color="#3A9D6E"; penwidth=0.9; margin=7;
{rank=same; l2i0 [label="Utility", fillcolor="white", color="#3A9D6E"]; l2i1 [label="Privacy", fillcolor="white", color="#3A9D6E"]; l2i2 [label="Fairness", fillcolor="white", color="#3A9D6E"]; l2i3 [label="Robustness", fillcolor="white", color="#3A9D6E"]; }
